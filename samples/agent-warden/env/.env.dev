# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev
AGENT_SCOPE=personal

# Generated during provision, you can also add your own variables.
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
M365_TITLE_ID=
M365_APP_ID=
SHARE_LINK=

# URL of the Agents SharePoint list that Agent Warden reads inventory from.
# This is the same list populated by the agent-sync-sharepoint sample.
# Set your value in env/.env.dev.user (gitignored) — do not set it here.
SHAREPOINT_AGENTS_LIST_URL=

# OAuth plugin vault reference ID for the API plugin auth configuration.
# The registration must request delegated scopes: CopilotPackages.ReadWrite.All,
# User.Read.All, Group.Read.All, Directory.Read.All, offline_access.
# Set your value in env/.env.dev.user (gitignored) — do not set it here.
OAUTH_PLUGIN_VAULT_REFERENCE_ID=

# SharePoint site and list identifiers for the write-back paths in openapi.yaml.
# SITE_ID is the Graph composite id: {hostname},{site-collection-id},{web-id}
# LIST_ID is the list GUID. Both are substituted into openapi.yaml at build time.
# Set your values in env/.env.dev.user (gitignored) — do not set them here.
SHAREPOINT_AGENTS_SITE_ID=
SHAREPOINT_AGENTS_LIST_ID=