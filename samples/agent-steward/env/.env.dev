# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev
AGENT_SCOPE=personal

# Generated during provision, you can also add your own variables.
TEAMS_APP_ID=53d70702-8208-42e9-9b77-e0d4113c5159
TEAMS_APP_TENANT_ID=8d89b635-2126-434d-a6b4-e4e40b741b75
M365_TITLE_ID=T_4df8b759-5d4b-159d-9ff1-ccdc1fb89769
M365_APP_ID=cb84ad1b-b077-4bc0-b085-1ba2bc752d95
SHARE_LINK=

# SharePoint document library URL for the agent usage report knowledge source.
# OPTIONAL: If you do not want to use the usage report, remove the OneDriveAndSharePoint
# capability block from appPackage/declarativeAgent.json and leave this value unset.
# If you do want to use it, set your value in env/.env.dev.user (gitignored) — do not set it here.
SHAREPOINT_KNOWLEDGE_URL=

# OAuth plugin vault reference ID for the API plugin auth configuration.
# Set your value in env/.env.dev.user (gitignored) — do not set it here.
OAUTH_PLUGIN_VAULT_REFERENCE_ID=